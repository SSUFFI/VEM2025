  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_10_Question
  m_EditorClassIdentifier: 
  questionText: "\uBB34\uB364\uC5D0\uC11C \uC790\uB780 \uB098\uBB34\uAC00 \uAD76\uC8FC\uB9B0
    \uB9C8\uC744\uC5D0 \uC5F4\uB9E4\uB97C \uC8FC\uC5C8\uB124. \uC5B4\uB290 \uB0A0\uBD80\uD130
    \uC5F4\uB9E4\uB97C \uBA39\uC740 \uC774\uB4E4\uC774 \uC8FD\uC740 \uC790\uC758
    \uAFC8\uC744 \uAFB8\uC9C0. \uC774 \uB098\uBB34\uB294 \uBB34\uC5C7\uC744 \uD558\uACE0
    \uC788\uB294 \uAC78\uAE4C?"
  answers:
  - answerText: "\uC0DD\uBA85\uC744 \uC787\uACE0 \uC788\uB2E4"
    rewardToken: {fileID: 11400000, guid: 66ab0f4d34e11194caf2b8e0a4dec320, type: 2}
    npcComment: "\uC5F4\uB9E4\uC5D0\uC11C \uC0B6\uC744 \uBCF4\uB294\uAD70. \uADF8
      \uC5F4\uB9E4\uAC00 \uAFB8\uAC8C \uD558\uB294 \uAFC8\uC5D0\uB3C4 \uBFCC\uB9AC\uAC00
      \uC788\uACA0\uC9C0."
  - answerText: "\uBAB8\uC744 \uBE4C\uB9AC\uB824 \uD55C\uB2E4"
    rewardToken: {fileID: 11400000, guid: 028abe153687e6440b8042ed537a4843, type: 2}
    npcComment: "\uBAB8\uC744 \uBE4C\uB9B0\uB2E4\u2026 \uBA39\uC740 \uC790\uAC00
      \uB098\uBB34\uB97C \uBC1B\uC544\uB4E4\uC778 \uAC83\uC778\uC9C0, \uB098\uBB34\uAC00
      \uADF8\uB97C \uC0BC\uD0A8 \uAC83\uC778\uC9C0."
  - answerText: "\uAE30\uC5B5\uC744 \uC804\uD558\uACE0 \uC788\uB2E4"
    rewardToken: {fileID: 11400000, guid: a767aeb2b20e5564180b844f53e601d8, type: 2}
    npcComment: "\uAE30\uC5B5\uC744 \uC804\uD55C\uB2E4\uB294\uAD70. \uBC1B\uB294
      \uC774\uAC00 \uC6D0\uD558\uC9C0 \uC54A\uC544\uB3C4 \uC720\uC0B0\uC774\uB77C
      \uBD80\uB97C \uC218 \uC788\uACA0\uB098."
