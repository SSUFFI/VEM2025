  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_08_Question
  m_EditorClassIdentifier: 
  questionText: "\uC8FD\uC9C0 \uC54A\uB294 \uC655 \uC544\uB798 \uBC31\uC131\uC740
    \uC624\uB798 \uD3C9\uC628\uD588\uB124. \uD5C8\uB098 \uC0C8 \uC655\uB3C4, \uC0C8\uB85C\uC6B4
    \uBC95\uB3C4 \uD0DC\uC5B4\uB098\uC9C0 \uBABB\uD588\uC9C0. \uC655\uC740 \uC774\uC81C
    \uC790\uB124\uC5D0\uAC8C \uC790\uC2E0\uC758 \uB05D\uC744 \uB9E1\uAE30\uB824 \uD558\uB124.
    \uBB34\uC5C7\uBD80\uD130 \uBB3B\uACA0\uB098?"
  answers:
  - answerText: "\uC65C \uB05D\uB0B4\uB824 \uD558\uB294\uAC00"
    rewardToken: {fileID: 11400000, guid: f01297ae42bb1864cb714d4e5c1a506d, type: 2}
    npcComment: "\uC8FD\uACE0 \uC2F6\uC740 \uC774\uC720\uB97C \uBB3B\uB294\uAD70.
      \uC0B4\uC544\uC628 \uC774\uC720\uC640 \uAC19\uC740 \uB300\uB2F5\uC774 \uB3CC\uC544\uC62C
      \uC218\uB3C4 \uC788\uB124."
  - answerText: "\uBC31\uC131\uB3C4 \uC6D0\uD558\uB294\uAC00"
    rewardToken: {fileID: 11400000, guid: 1cc0ed3bfc5cbfe49a6c24741baaa40f, type: 2}
    npcComment: "\uBC31\uC131\uC758 \uBAA9\uC18C\uB9AC\uB97C \uB4E3\uACA0\uAD70.
      \uC655\uC744 \uC0AC\uB791\uD558\uB294 \uC774\uC640 \uC655\uC774 \uD544\uC694\uD55C
      \uC774\uB97C \uAD6C\uBCC4\uD560 \uC218 \uC788\uACA0\uB098."
  - answerText: "\uB4A4\uB97C \uC774\uC744 \uC790\uB294"
    rewardToken: {fileID: 11400000, guid: b5e1230c01bf7284081496c20c43061c, type: 2}
    npcComment: "\uBE48 \uC655\uC88C\uBD80\uD130 \uBCF4\uB294\uAD70. \uB2E4\uC74C\uC5D0
      \uC549\uC744 \uC790\uC5D0\uAC8C\uB3C4 \uB05D\uC744 \uD5C8\uB77D\uD560 \uC0DD\uAC01\uC778\uAC00."
