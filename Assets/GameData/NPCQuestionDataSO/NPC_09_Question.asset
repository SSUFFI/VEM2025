  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_09_Question
  m_EditorClassIdentifier: 
  questionText: "\uAC19\uC740 \uC804\uC7A5\uC5D0\uC11C \uB450 \uC0AC\uB78C\uC774
    \uC0B4\uC544 \uB3CC\uC544\uAC00\uAE38 \uBE4C\uC5C8\uB124. \uD55C\uCABD\uC758
    \uAE30\uB3C4\uAC00 \uC774\uB8E8\uC5B4\uC9C0\uB824\uBA74 \uB2E4\uB978 \uCABD\uC740
    \uB3CC\uC544\uAC00\uC9C0 \uBABB\uD558\uC9C0. \uC2E0\uC774 \uC790\uB124\uC5D0\uAC8C
    \uC120\uD0DD\uC744 \uB118\uAE34\uB2E4\uBA74, \uB204\uAD6C\uC758 \uB9D0\uC744
    \uB4E3\uACA0\uB098?"
  answers:
  - answerText: "\uB354 \uC808\uBC15\uD55C \uC0AC\uB78C"
    rewardToken: {fileID: 11400000, guid: 022bc19273559ef48aa607846ed166e1, type: 2}
    npcComment: "\uB354 \uAC04\uC808\uD55C \uBAA9\uC18C\uB9AC\uB97C \uD0DD\uD588\uAD70.
      \uC18C\uB9AC \uB0BC \uD798\uC870\uCC28 \uC5C6\uB294 \uAE30\uB3C4\uB294 \uC5B4\uB514\uC5D0
      \uB450\uACA0\uB098."
  - answerText: "\uB354 \uB9CE\uC740 \uC774\uB97C \uC0B4\uB9B4 \uC790"
    rewardToken: {fileID: 11400000, guid: 1cc0ed3bfc5cbfe49a6c24741baaa40f, type: 2}
    npcComment: "\uC544\uC9C1 \uC0B4\uC544\uB098\uC9C0 \uC54A\uC740 \uC774\uB4E4\uAE4C\uC9C0
      \uC138\uB294\uAD70. \uADF8 \uC218\uB97C \uC57D\uC18D\uD55C \uC790\uB294 \uB204\uAD6C\uC600\uC9C0?"
  - answerText: "\uBA3C\uC800 \uC190 \uB0B4\uBBFC \uC0AC\uB78C"
    rewardToken: {fileID: 11400000, guid: 87ac1b5cad2df9f458b3a4af2660bd2e, type: 2}
    npcComment: "\uBA3C\uC800 \uB2FF\uC740 \uC190\uC744 \uC7A1\uB294\uAD70. \uC870\uAE08
      \uB2A6\uC740 \uC190\uB3C4 \uAC19\uC740 \uC628\uAE30\uC600\uC744 \uD150\uB370."
