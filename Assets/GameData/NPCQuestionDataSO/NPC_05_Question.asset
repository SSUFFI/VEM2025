  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_05_Question
  m_EditorClassIdentifier: 
  questionText: "\uB0B4\uC77C \uC8FD\uC744 \uC774\uC5D0\uAC8C \uC624\uB298 \uC0AC\uC2E4\uC744
    \uB9D0\uD574 \uC8FC\uBA74, \uADF8\uB294 \uB0A8\uC740 \uD558\uB8E8\uB97C \uB450\uB824\uC6C0
    \uC18D\uC5D0 \uBCF4\uB0BC\uC9C0\uB3C4 \uBAA8\uB974\uB124. \uC785\uC744 \uB2E4\uBB3C\uBA74
    \uB05D\uAE4C\uC9C0 \uC6C3\uC744 \uC218\uB3C4 \uC788\uC9C0. \uC790\uB124\uB294
    \uBB34\uC5C7\uC744 \uAC74\uB124\uACA0\uB098?"
  answers:
  - answerText: "\uC0AC\uC2E4\uC744 \uB9D0\uD55C\uB2E4"
    rewardToken: {fileID: 11400000, guid: b8194b661800fbf429010824e4932488, type: 2}
    npcComment: "\uC774\uC81C \uADF8\uB294 \uB9C8\uC9C0\uB9C9 \uB0A0\uC744 \uC54C\uACA0\uAD70.
      \uC790\uB124\uAC00 \uADF8\uB0A0\uC744 \uC5B4\uB5BB\uAC8C \uBC14\uAFB8\uC5C8\uB294\uC9C0\uB3C4."
  - answerText: "\uD3C9\uC628\uC744 \uC9C0\uCF1C \uC900\uB2E4"
    rewardToken: {fileID: 11400000, guid: 6edef52451089124e83c304509192e6e, type: 2}
    npcComment: "\uD3C9\uC628\uC744 \uAC74\uB124\uB294\uAD70. \uC791\uBCC4\uD560
      \uAE30\uD68C\uAE4C\uC9C0 \uD568\uAED8 \uB36E\uC774\uC9C0 \uC54A\uAE30\uB97C
      \uBC14\uB77C\uB124."
  - answerText: "\uC54C\uACE0 \uC2F6\uC740\uC9C0 \uBB3B\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: 0b2f3cd853f7fbe46a0708658b809ee7, type: 2}
    npcComment: "\uC54C\uACE0 \uC2F6\uB2E4\uB294 \uB300\uB2F5 \uB4A4\uC5D0\uB294
      \uB418\uB3CC\uC544\uAC08 \uCE68\uBB35\uC774 \uC5C6\uB124. \uADF8\uB798\uB3C4
      \uBB3B\uACA0\uB098."
