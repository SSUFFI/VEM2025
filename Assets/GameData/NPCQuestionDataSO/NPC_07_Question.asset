  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_07_Question
  m_EditorClassIdentifier: 
  questionText: "\uC800\uC790\uB294 \uC7A0\uB4E0 \uB3D9\uC548\uC5D0\uB9CC \uC8FD\uC740
    \uAC00\uC871\uACFC \uD568\uAED8 \uC0B4\uC9C0. \uAE68\uC6B0\uBA74 \uC0B4\uC544\uB0A8\uC9C0\uB9CC,
    \uB2E4\uC2DC\uB294 \uADF8 \uAFC8\uC73C\uB85C \uB3CC\uC544\uAC08 \uC218 \uC5C6\uB124.
    \uADF8\uB294 \uC7A0\uB4E4\uAE30 \uC804 \uAE68\uC6CC \uB2EC\uB77C \uD588\uB294\uB370\u2026
    \uC9C0\uAE08\uB3C4 \uADF8\uB7F4\uAE4C?"
  answers:
  - answerText: "\uC57D\uC18D\uB300\uB85C \uAE68\uC6B4\uB2E4"
    rewardToken: {fileID: 11400000, guid: 022bc19273559ef48aa607846ed166e1, type: 2}
    npcComment: "\uC57D\uC18D\uC740 \uC9C0\uCF1C\uC9C0\uACA0\uAD70. \uB208\uB72C
      \uADF8\uAC00 \uACE0\uB9D9\uB2E4\uACE0 \uB9D0\uD560\uC9C0\uB294 \uC57D\uC18D\uD558\uC9C0
      \uC54A\uC558\uC9C0\uB9CC."
  - answerText: "\uAFC8\uC5D0 \uBA38\uBB3C\uAC8C \uD55C\uB2E4"
    rewardToken: {fileID: 11400000, guid: 6edef52451089124e83c304509192e6e, type: 2}
    npcComment: "\uAC00\uC871\uACFC \uD568\uAED8 \uB450\uB294\uAD70. \uAFC8\uBC16\uC5D0\uC11C
      \uADF8\uB97C \uAE30\uB2E4\uB9AC\uB294 \uC774\uB3C4 \uC788\uC744\uAE4C."
  - answerText: "\uAFC8\uC18D \uB73B\uC744 \uBB3B\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: aadd5ca7458a3704e93446984d4d4236, type: 2}
    npcComment: "\uAFC8\uC18D\uC758 \uADF8\uB3C4 \uAC19\uC740 \uC0AC\uB78C\uC77C\uAE4C?
      \uC790\uB124\uB294 \uC5B4\uB290 \uCABD\uC758 \uB300\uB2F5\uC744 \uC57D\uC18D\uC73C\uB85C
      \uC0BC\uACA0\uB098."
