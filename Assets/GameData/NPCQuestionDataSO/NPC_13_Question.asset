  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_13_Question
  m_EditorClassIdentifier: 
  questionText: "\uC774 \uC800\uC6B8\uC5D0\uB294 \uB0A8\uC740 \uC218\uBA85\uC774
    \uBCF4\uC778\uB2E4\uB124. \uD55C\uCABD\uC5D0\uB294 \uD558\uB8E8 \uB0A8\uC740
    \uC544\uC774\uAC00, \uB2E4\uB978 \uCABD\uC5D0\uB294 \uBC31 \uB144 \uB0A8\uC740
    \uB178\uC778\uC774 \uC11C \uC788\uC9C0. \uD55C \uC0AC\uB78C\uB9CC \uAC74\uB110
    \uBC30\uB77C\uBA74, \uC790\uB124\uB294 \uBB34\uC5C7\uC744 \uAE30\uC900 \uC0BC\uACA0\uB098?"
  answers:
  - answerText: "\uB0A8\uC740 \uB0A0\uC758 \uAE38\uC774"
    rewardToken: {fileID: 11400000, guid: 87ac1b5cad2df9f458b3a4af2660bd2e, type: 2}
    npcComment: "\uAE38\uC774\uB85C \uC7AC\uB294\uAD70. \uADF8 \uAE34 \uB0A0\uB4E4\uC744
      \uC5B4\uB5BB\uAC8C \uC4F8\uC9C0\uB294 \uC800\uC6B8\uC5D0\uB3C4 \uB098\uC624\uC9C0
      \uC54A\uB124."
  - answerText: "\uB2F9\uC0AC\uC790\uB4E4\uC758 \uB73B"
    rewardToken: {fileID: 11400000, guid: 0b2f3cd853f7fbe46a0708658b809ee7, type: 2}
    npcComment: "\uB450 \uC0AC\uB78C\uC774 \uC11C\uB85C\uB97C \uBCF4\uB0B4 \uB2EC\uB77C
      \uD558\uBA74, \uC790\uB124\uB294 \uB2E4\uC2DC \uBB34\uC5C7\uC744 \uC7AC\uACA0\uB098."
  - answerText: "\uAE30\uB2E4\uB9AC\uB294 \uC774\uC758 \uC218"
    rewardToken: {fileID: 11400000, guid: 1cc0ed3bfc5cbfe49a6c24741baaa40f, type: 2}
    npcComment: "\uAE30\uB2E4\uB9AC\uB294 \uC774\uB4E4\uC744 \uC138\uB294\uAD70.
      \uC544\uBB34\uB3C4 \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uB294 \uC0B6\uC740 \uC5BC\uB9C8\uB098
      \uAC00\uBCBC\uC6B8\uAE4C."
