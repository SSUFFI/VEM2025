  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_16_Question
  m_EditorClassIdentifier: 
  questionText: "\uC800 \uBB38\uC9C0\uAE30\uB294 \uC8FD\uC740 \uB4A4\uC5D0\uB3C4
    \uB9C8\uC744\uC744 \uC9C0\uD0A4\uACE0 \uC788\uB124. \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740
    \uADF8\uAC00 \uC26C\uAE38 \uBC14\uB77C\uC9C0\uB9CC, \uBB38 \uB108\uBA38\uC758
    \uAC83\uB4E4\uC740 \uC544\uC9C1 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC558\uC9C0.
    \uC790\uB124\uB77C\uBA74 \uADF8\uC5D0\uAC8C \uBB34\uC5C7\uC744 \uC8FC\uACA0\uB098?"
  answers:
  - answerText: "\uC274 \uC218 \uC788\uB294 \uB05D"
    rewardToken: {fileID: 11400000, guid: d614d8b7c6778164fa441ea8074cc445, type: 2}
    npcComment: "\uADF8\uC5D0\uAC8C \uB05D\uC744 \uC8FC\uB294\uAD70. \uBB38\uBC16\uC758
      \uAC83\uB4E4\uB3C4 \uADF8 \uC21C\uAC04\uC744 \uAE30\uB2E4\uB824 \uC654\uACA0\uC9C0."
  - answerText: "\uACC4\uC18D \uC9C0\uD0AC \uD798"
    rewardToken: {fileID: 11400000, guid: b5e1230c01bf7284081496c20c43061c, type: 2}
    npcComment: "\uD798\uC744 \uB354\uD558\uACA0\uB2E4\uB294\uAD70. \uBC84\uD2F8
      \uC218 \uC788\uB2E4\uB294 \uAC83\uC774 \uB354 \uBC84\uD2F0\uACE0 \uC2F6\uB2E4\uB294
      \uB73B\uC77C\uAE4C."
  - answerText: "\uB300\uC2E0 \uC124 \uC0AC\uB78C"
    rewardToken: {fileID: 11400000, guid: 1cc0ed3bfc5cbfe49a6c24741baaa40f, type: 2}
    npcComment: "\uB2E4\uC74C \uBB38\uC9C0\uAE30\uB97C \uCC3E\uB294\uAD70. \uADF8\uC5D0\uAC8C\uB3C4
      \uC5B8\uC820\uAC00 \uAC19\uC740 \uC9C8\uBB38\uC744 \uD574 \uC904 \uD150\uAC00."
