  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_19_Question
  m_EditorClassIdentifier: 
  questionText: "\uBAA8\uB4E0 \uC774\uC758 \uB9C8\uC9C0\uB9C9 \uB0A0\uC744 \uC77D\uB294
    \uC790\uAC00 \uC788\uC5C8\uB124. \uADF8\uB294 \uC218\uB9CE\uC740 \uC8FD\uC74C\uC744
    \uD53C\uD558\uAC8C \uD588\uC9C0\uB9CC, \uBC14\uB010 \uB05D\uC774 \uC5B4\uB514\uB85C
    \uAC14\uB294\uC9C0\uB294 \uBCF4\uC9C0 \uBABB\uD588\uC9C0. \uADF8\uAC00 \uC790\uB124\uC758
    \uB0A0\uB3C4 \uC77D\uC5B4 \uC8FC\uACA0\uB2E4\uB294\uB370?"
  answers:
  - answerText: "\uB0B4 \uB05D\uC744 \uC54C\uB824 \uB2EC\uB77C"
    rewardToken: {fileID: 11400000, guid: 2491c485c9c20db4f8ad303f1776378e, type: 2}
    npcComment: "\uC54C\uB824 \uB2EC\uB77C\uB294\uAD70. \uADF8\uB0A0\uC744 \uC54C\uAC8C
      \uB41C \uB4A4\uC5D0\uB3C4 \uC624\uB298\uC744 \uAC19\uC740 \uC18D\uB3C4\uB85C
      \uAC78\uC744 \uC218 \uC788\uACA0\uB098."
  - answerText: "\uBAA8\uB974\uB294 \uCC44 \uC0B4\uACA0\uB2E4"
    rewardToken: {fileID: 11400000, guid: a6cf9b8c4e57b494da4215700341c5ee, type: 2}
    npcComment: "\uBAA8\uB974\uB294 \uCC44 \uAC77\uACA0\uB2E4\uB294\uAD70. \uB208\uC744
      \uAC10\uC544\uB3C4 \uAE38\uC740 \uC774\uC5B4\uC9C0\uC9C0. \uC5B4\uB514\uC778\uC9C0\uB294
      \uBAB0\uB77C\uB3C4."
  - answerText: "\uBC14\uB010 \uB05D\uBD80\uD130 \uCC3E\uACA0\uB2E4"
    rewardToken: {fileID: 11400000, guid: d614d8b7c6778164fa441ea8074cc445, type: 2}
    npcComment: "\uC0AC\uB77C\uC9C4 \uB05D\uC744 \uCC3E\uB294\uAD70. \uADF8 \uB05D\uC774
      \uB204\uAD70\uAC00\uC758 \uC2DC\uC791\uC5D0 \uB2FF\uC544 \uC788\uB2E4\uBA74
      \uC5B4\uCC0C\uD558\uACA0\uB098."
