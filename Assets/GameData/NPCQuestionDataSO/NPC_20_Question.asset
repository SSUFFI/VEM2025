  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_20_Question
  m_EditorClassIdentifier: 
  questionText: "\uC774 \uC232\uC744 \uB098\uAC00\uB824\uBA74 \uC8FD\uC740 \uC774\uC758
    \uC774\uB984 \uD558\uB098\uB97C \uB0A8\uACA8\uC57C \uD558\uB124. \uB0A8\uACA8\uC9C4
    \uC774\uB984\uC740 \uB204\uAD6C\uB3C4 \uB2E4\uC2DC \uAE30\uC5B5\uD558\uC9C0 \uBABB\uD558\uC9C0.
    \uB098\uB294 \uBE48 \uC885\uC774\uB97C \uB0B4\uBC00 \uBFD0\uC77C\uC138. \uC790\uB124\uB294
    \uBB34\uC5C7\uC744 \uC801\uACA0\uB098?"
  answers:
  - answerText: "\uAC00\uC7A5 \uADF8\uB9AC\uC6B4 \uC774\uB984"
    rewardToken: {fileID: 11400000, guid: a767aeb2b20e5564180b844f53e601d8, type: 2}
    npcComment: "\uAC00\uC7A5 \uADF8\uB9AC\uC6B4 \uC774\uB97C \uB450\uACE0 \uAC00\uB294\uAD70.
      \uC232\uC744 \uB098\uC120 \uB4A4 \uB208\uBB3C\uC758 \uC774\uC720\uB294 \uBB34\uC5C7\uC774\uB77C
      \uBD80\uB974\uACA0\uB098."
  - answerText: "\uAC00\uC7A5 \uBBF8\uC6CC\uD55C \uC774\uB984"
    rewardToken: {fileID: 11400000, guid: 2721d04d6d74207479bc783c61633abc, type: 2}
    npcComment: "\uBBF8\uC6C0\uAE4C\uC9C0 \uB0A8\uAE30\uB824\uB294\uAD70. \uADF8
      \uC774\uB984\uC744 \uC9C0\uC6B0\uBA74 \uC6A9\uC11C\uD55C \uAC83\uC778\uC9C0\uB3C4
      \uBAA8\uB974\uAC8C \uB418\uACA0\uC9C0."
  - answerText: "\uC544\uBB34\uAC83\uB3C4 \uC548 \uC801\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: 87ac1b5cad2df9f458b3a4af2660bd2e, type: 2}
    npcComment: "\uBE48 \uC885\uC774\uB97C \uB3CC\uB824\uC8FC\uB294\uAD70. \uC774\uB984\uC744
      \uC9C0\uD0A8 \uB300\uAC00\uAC00 \uBB34\uC5C7\uC77C\uC9C0\uB294 \uC544\uC9C1
      \uB9D0\uD558\uC9C0 \uC54A\uC558\uB124."
