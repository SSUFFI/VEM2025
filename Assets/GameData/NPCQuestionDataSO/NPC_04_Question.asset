  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_04_Question
  m_EditorClassIdentifier: 
  questionText: "\uC774 \uB4F1\uBD88\uC744 \uB4E4\uBA74 \uC790\uB124\uC758 \uC228\uC740
    \uB04A\uC5B4\uC9C0\uC9C0 \uC54A\uB124. \uB2E4\uB9CC \uC790\uB124\uB97C \uC0AC\uB791\uD55C
    \uC774\uB4E4\uC740 \uD558\uB098\uC529 \uC790\uB124\uB97C \uC78A\uAC8C \uB418\uC9C0.
    \uB9C8\uC9C0\uB9C9 \uC774\uB984\uB9C8\uC800 \uC9C0\uC6CC\uC9C4 \uB4A4\uC5D0\uB3C4,
    \uBD88\uC744 \uC9C0\uD0A4\uACA0\uB098?"
  answers:
  - answerText: "\uB05D\uAE4C\uC9C0 \uC9C0\uD0A8\uB2E4"
    rewardToken: {fileID: 11400000, guid: 2491c485c9c20db4f8ad303f1776378e, type: 2}
    npcComment: "\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uBD88\uC744 \uB4E4\uACE0 \uC788\uACA0\uAD70.
      \uADF8 \uBE5B\uC744 \uB204\uAD6C\uC5D0\uAC8C \uBCF4\uC5EC \uC8FC\uB824\uB294\uC9C0\uB294
      \uC78A\uC9C0 \uB9D0\uAC8C."
  - answerText: "\uB4F1\uBD88\uC744 \uB0B4\uB824\uB193\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: d614d8b7c6778164fa441ea8074cc445, type: 2}
    npcComment: "\uBD88\uC744 \uB0B4\uB824\uB193\uB294 \uC190\uB3C4 \uB5A8\uB9AC\uB294\uAD70.
      \uB193\uCE5C \uAC83\uC774 \uC800\uC8FC\uC600\uB294\uC9C0 \uC120\uBB3C\uC774\uC5C8\uB294\uC9C0\uB294
      \uB098\uC911\uC5D0 \uC54C\uACA0\uC9C0."
  - answerText: "\uC0C8 \uC778\uC5F0\uC744 \uB9FA\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: 66ab0f4d34e11194caf2b8e0a4dec320, type: 2}
    npcComment: "\uB2E4\uC2DC \uC0AC\uB791\uBC1B\uACA0\uB2E4\uB294 \uAC74\uAC00,
      \uB2E4\uC2DC \uC78A\uD788\uACA0\uB2E4\uB294 \uAC74\uAC00. \uC2DC\uC791\uD560
      \uB54C\uB294 \uAD6C\uBCC4\uD558\uAE30 \uC5B4\uB835\uC9C0."
