  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_17_Question
  m_EditorClassIdentifier: 
  questionText: "\uC774 \uB9C8\uC744\uC5D0\uB294 \uC7A5\uB840\uAC00 \uC5C6\uB124.
    \uB204\uAD70\uAC00 \uC228\uC744 \uAC70\uB450\uBA74 \uB2E4\uC74C \uB0A0 \uB204\uAD6C\uB3C4
    \uADF8\uB97C \uAE30\uC5B5\uD558\uC9C0 \uBABB\uD558\uAC70\uB4E0. \uC2AC\uD514
    \uC5C6\uB294 \uC774\uACF3\uC744 \uB5A0\uB098\uB824\uB294 \uC790\uAC00 \uC790\uB124\uC5D0\uAC8C
    \uAE38\uC744 \uBB3B\uB124. \uC5B4\uB5BB\uAC8C \uD558\uACA0\uB098?"
  answers:
  - answerText: "\uD568\uAED8 \uAE38\uC744 \uCC3E\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: 0b2f3cd853f7fbe46a0708658b809ee7, type: 2}
    npcComment: "\uD568\uAED8 \uB5A0\uB098\uACA0\uB2E4\uB294\uAD70. \uAE38 \uB05D\uC5D0\uC11C
      \uB418\uCC3E\uC744 \uC2AC\uD514\uAE4C\uC9C0 \uB3D9\uD589\uD560 \uC218 \uC788\uACA0\uB098."
  - answerText: "\uB0A8\uC744 \uC774\uC720\uB97C \uBB3B\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: 74982e6165e93854fa378115856bb010, type: 2}
    npcComment: "\uBA38\uBB3C \uC774\uC720\uB97C \uBB3B\uB294\uAD70. \uADF8\uAC00
      \uC78A\uC740 \uC774\uB984 \uC18D\uC5D0 \uB2F5\uC774 \uC788\uC5C8\uB2E4\uBA74
      \uC5B4\uCA4C\uACA0\uB098."
  - answerText: "\uC78A\uD78C \uC774\uB984\uC744 \uCC3E\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: a767aeb2b20e5564180b844f53e601d8, type: 2}
    npcComment: "\uC774\uB984\uC744 \uCC3E\uB294\uAD70. \uB418\uCC3E\uC740 \uC774\uB9C8\uB2E4
      \uC6B8\uC74C\uB3C4 \uD558\uB098\uC529 \uB3CC\uC544\uC62C \uD150\uB370."
