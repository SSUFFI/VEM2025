  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_14_Question
  m_EditorClassIdentifier: 
  questionText: "\uC8FD\uC740 \uC774\uAC00 \uB9C8\uC9C0\uB9C9 \uD3B8\uC9C0\uB97C
    \uD0DC\uC6CC \uB2EC\uB77C \uBD80\uD0C1\uD588\uB124. \uD3B8\uC9C0\uC5D0\uB294
    \uADF8\uAC00 \uB204\uAD6C\uB97C \uC0B4\uB9AC\uACE0 \uB204\uAD6C\uB97C \uBC84\uB838\uB294\uC9C0
    \uC801\uD600 \uC788\uC9C0. \uC720\uC871\uC740 \uC9C4\uC2E4\uC744 \uAE30\uB2E4\uB9AC\uACE0
    \uC788\uB124. \uC790\uB124\uB294 \uD3B8\uC9C0\uB97C \uC5B4\uCC0C\uD558\uACA0\uB098?"
  answers:
  - answerText: "\uBD80\uD0C1\uB300\uB85C \uD0DC\uC6B4\uB2E4"
    rewardToken: {fileID: 11400000, guid: 6edef52451089124e83c304509192e6e, type: 2}
    npcComment: "\uD3B8\uC9C0\uB294 \uC7AC\uAC00 \uB418\uACA0\uAD70. \uC4F0\uC778
      \uC77C\uB4E4\uAE4C\uC9C0 \uD568\uAED8 \uD0C0 \uBC84\uB9AC\uC9C0\uB294 \uC54A\uC744
      \uD150\uB370."
  - answerText: "\uC720\uC871\uC5D0\uAC8C \uC804\uD55C\uB2E4"
    rewardToken: {fileID: 11400000, guid: a767aeb2b20e5564180b844f53e601d8, type: 2}
    npcComment: "\uC0B0 \uC790\uC5D0\uAC8C \uB3CC\uB824\uC8FC\uB294\uAD70. \uC8FD\uC740
      \uC774\uAC00 \uB0A8\uAE34 \uCE68\uBB35\uB3C4 \uC720\uC0B0\uC774\uC5C8\uB2E4\uBA74
      \uC5B4\uCA4C\uB098."
  - answerText: "\uBA3C\uC800 \uB0B4\uC6A9\uC744 \uC77D\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: 2491c485c9c20db4f8ad303f1776378e, type: 2}
    npcComment: "\uBA3C\uC800 \uC77D\uACA0\uB2E4\uB294\uAD70. \uC54C\uAC8C \uB41C
      \uB4A4\uC5D0\uB3C4 \uD0DC\uC6B0\uB294 \uC190\uC740 \uAC19\uC744 \uC218 \uC788\uC744\uAE4C."
