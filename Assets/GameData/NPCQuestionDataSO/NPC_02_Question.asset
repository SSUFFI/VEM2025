  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_02_Question
  m_EditorClassIdentifier: 
  questionText: "\uC800 \uBB34\uB364\uC758 \uC8FC\uC778\uC740 \uC624\uB798\uC804\uC5D0
    \uC8FD\uC5C8\uB124. \uADF8\uB7F0\uB370 \uC774\uB984\uC744 \uBD80\uB974\uBA74
    \uC544\uC9C1 \uB300\uB2F5\uD558\uC9C0. \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uADF8\uB97C
    \uAE30\uC5B5\uD558\uB294 \uC790\uAC00 \uC624\uB298 \uC774 \uC232\uC744 \uB5A0\uB09C\uB2E4\uB354\uAD70.
    \uADF8\uB294 \uC5B8\uC81C \uC8FD\uB294 \uAC78\uAE4C?"
  answers:
  - answerText: "\uC228\uC774 \uBA4E\uC5C8\uC744 \uB54C"
    rewardToken: {fileID: 11400000, guid: d614d8b7c6778164fa441ea8074cc445, type: 2}
    npcComment: "\uADF8\uB807\uB2E4\uBA74 \uC790\uB124\uC5D0\uAC8C \uB300\uB2F5\uD55C
      \uBAA9\uC18C\uB9AC\uB294 \uB204\uAD6C\uC758 \uAC83\uC774\uC5C8\uC744\uAE4C."
  - answerText: "\uC78A\uD788\uB294 \uC21C\uAC04"
    rewardToken: {fileID: 11400000, guid: a767aeb2b20e5564180b844f53e601d8, type: 2}
    npcComment: "\uAE30\uC5B5\uD558\uB294 \uC790\uC5D0\uAC8C \uB9C8\uC9C0\uB9C9 \uC228\uC744
      \uB9E1\uAE30\uB294 \uC148\uC774\uAD70. \uAF64 \uBB34\uAC70\uC6B4 \uBD80\uD0C1\uC774\uC57C."
  - answerText: "\uB300\uB2F5\uC774 \uC5C6\uC744 \uB54C"
    rewardToken: {fileID: 11400000, guid: 6edef52451089124e83c304509192e6e, type: 2}
    npcComment: "\uCE68\uBB35\uC744 \uB05D\uC774\uB77C \uC5EC\uAE30\uB294\uAD70.
      \uB300\uB2F5\uD558\uACE0 \uC2F6\uC5B4\uB3C4 \uBABB \uD558\uB294 \uC790\uB294
      \uC5B4\uCA4C\uB098."
