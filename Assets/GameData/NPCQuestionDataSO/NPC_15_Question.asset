  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_15_Question
  m_EditorClassIdentifier: 
  questionText: "\uC790\uB124\uAC00 \uC8FD\uC74C\uC744 \uD53C\uD560 \uB54C\uB9C8\uB2E4
    \uADF8\uB9BC\uC790\uAC00 \uC870\uAE08\uC529 \uC605\uC5B4\uC84C\uB124. \uC624\uB298\uC740
    \uADF8\uB9BC\uC790\uAC00 \uBA3C\uC800 \uC800\uD3B8\uC73C\uB85C \uAC78\uC5B4\uAC00\uB354\uAD70.
    \uB4A4\uB3CC\uC544\uBCF4\uBA70 \uC790\uB124 \uC774\uB984\uC744 \uBD80\uB974\uB294\uB370,
    \uC5B4\uB290 \uCABD\uC774 \uC0B4\uC544 \uC788\uB294 \uAC78\uAE4C?"
  answers:
  - answerText: "\uC228 \uC26C\uB294 \uC774\uCABD"
    rewardToken: {fileID: 11400000, guid: a6cf9b8c4e57b494da4215700341c5ee, type: 2}
    npcComment: "\uC228\uC744 \uC99D\uAC70\uB85C \uC0BC\uB294\uAD70. \uADF8\uB807\uB2E4\uBA74
      \uC790\uB124 \uC774\uB984\uC744 \uBD80\uB978 \uC800 \uC228\uC740 \uB204\uAD6C\uC758
      \uAC83\uC778\uAC00."
  - answerText: "\uB5A0\uB098\uAC00\uB294 \uC800\uCABD"
    rewardToken: {fileID: 11400000, guid: aadd5ca7458a3704e93446984d4d4236, type: 2}
    npcComment: "\uB5A0\uB098\uB294 \uCABD\uC744 \uD0DD\uD588\uAD70. \uC5EC\uAE30
      \uB0A8\uC544 \uB300\uB2F5\uD558\uB294 \uC790\uB124\uB294 \uBB34\uC5C7\uC774
      \uB418\uB294 \uAC78\uAE4C."
  - answerText: "\uB458 \uB2E4 \uB098\uC758 \uC77C\uBD80"
    rewardToken: {fileID: 11400000, guid: 87ac1b5cad2df9f458b3a4af2660bd2e, type: 2}
    npcComment: "\uB458 \uB2E4 \uD488\uACA0\uB2E4\uB294\uAD70. \uC11C\uB85C \uB2E4\uB978
      \uAE38\uC744 \uACE0\uB974\uBA74 \uC5B4\uB290 \uBC1C\uC744 \uBA3C\uC800 \uC62E\uAE30\uACA0\uB098."
