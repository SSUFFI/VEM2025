  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_12_Question
  m_EditorClassIdentifier: 
  questionText: "\uB9CE\uC740 \uC774\uB97C \uC8FD\uC778 \uC790\uAC00 \uBAA8\uB4E0
    \uAE30\uC5B5\uC744 \uC783\uC5C8\uB124. \uC9C0\uAE08\uC740 \uB2E4\uCE5C \uC774\uB4E4\uC744
    \uB3CC\uBCF4\uBA70 \uC0B4\uACE0 \uC788\uC9C0. \uC8FD\uC740 \uC790\uB4E4\uC758
    \uC774\uB984\uC744 \uB4E4\uB824\uC8FC\uBA74 \uC61B \uAE30\uC5B5\uC774 \uB3CC\uC544\uC628\uB2E4\uB124.
    \uC790\uB124\uB294 \uC785\uC744 \uC5F4\uACA0\uB098?"
  answers:
  - answerText: "\uBAA8\uB4E0 \uC774\uB984\uC744 \uC77D\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: 2721d04d6d74207479bc783c61633abc, type: 2}
    npcComment: "\uC774\uB984\uC744 \uB3CC\uB824\uC8FC\uACA0\uAD70. \uAE30\uC5B5\uACFC
      \uD568\uAED8 \uC608\uC804\uC758 \uADF8\uAE4C\uC9C0 \uB3CC\uC544\uC624\uBA74
      \uC5B4\uCC0C\uD558\uACA0\uB098."
  - answerText: "\uC9C0\uAE08\uC758 \uC0B6\uC744 \uC9C0\uD0A8\uB2E4"
    rewardToken: {fileID: 11400000, guid: 022bc19273559ef48aa607846ed166e1, type: 2}
    npcComment: "\uC9C0\uAE08\uC758 \uC190\uC744 \uBBFF\uB294\uAD70. \uADF8 \uC190\uC744
      \uAE30\uC5B5\uD558\uB294 \uC720\uC871\uC758 \uB208\uB3C4 \uB9C8\uC8FC\uD560
      \uC218 \uC788\uACA0\uB098."
  - answerText: "\uC720\uC871\uC758 \uB73B\uC744 \uBB3B\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: a767aeb2b20e5564180b844f53e601d8, type: 2}
    npcComment: "\uB0A8\uACA8\uC9C4 \uC774\uB4E4\uC5D0\uAC8C \uBB3B\uB294\uAD70.
      \uC11C\uB85C \uB2E4\uB978 \uB2F5\uC774 \uC624\uBA74 \uB204\uAD6C\uC758 \uC2AC\uD514\uC744
      \uB530\uB974\uACA0\uB098."
