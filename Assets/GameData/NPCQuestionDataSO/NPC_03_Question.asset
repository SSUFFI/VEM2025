  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_03_Question
  m_EditorClassIdentifier: 
  questionText: "\uC8FD\uC740 \uBC97\uC774 \uB3CC\uC544\uC640 \uC790\uB124\uB9CC
    \uC544\uB294 \uC774\uC57C\uAE30\uB97C \uD558\uB124. \uBAA9\uC18C\uB9AC\uB3C4
    \uC6C3\uC74C\uB3C4 \uAC19\uC9C0\uB9CC, \uAC70\uC6B8\uC5D0\uB294 \uB0AF\uC120
    \uC5BC\uAD74\uC774 \uBE44\uCE58\uC9C0. \uBB38\uBC16\uC758 \uADF8\uB97C \uBB34\uC5C7\uC774\uB77C
    \uBD80\uB974\uACA0\uB098?"
  answers:
  - answerText: "\uB0B4 \uBC97\uC774\uB77C \uBD80\uB978\uB2E4"
    rewardToken: {fileID: 11400000, guid: a767aeb2b20e5564180b844f53e601d8, type: 2}
    npcComment: "\uC774\uB984\uC744 \uBD88\uB7EC \uC8FC\uC5C8\uAD70. \uADF8\uB3C4
      \uC774\uC81C \uADF8 \uC774\uB984\uC73C\uB85C \uC0B4\uC544\uAC00\uB824 \uD558\uACA0\uC9C0."
  - answerText: "\uAD34\uBB3C\uC774\uB77C \uBD80\uB978\uB2E4"
    rewardToken: {fileID: 11400000, guid: b8194b661800fbf429010824e4932488, type: 2}
    npcComment: "\uBC97\uB9CC \uC54C\uB358 \uC774\uC57C\uAE30\uB3C4 \uC1A1\uACF3\uB2C8
      \uC55E\uC5D0\uC11C\uB294 \uD798\uC744 \uC783\uB294 \uBAA8\uC591\uC774\uAD70."
  - answerText: "\uC774\uB984\uBD80\uD130 \uBB3B\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: 6edef52451089124e83c304509192e6e, type: 2}
    npcComment: "\uC775\uC219\uD55C \uC774\uB984\uC774 \uB3CC\uC544\uC624\uBA74 \uC548\uC2EC\uD558\uACA0\uB098?
      \uC774\uB984\uC740 \uC5BC\uAD74\uBCF4\uB2E4 \uBE4C\uB9AC\uAE30 \uC27D\uC9C0."
