  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_11_Question
  m_EditorClassIdentifier: 
  questionText: "\uBB34\uB108\uC9C4 \uB2E4\uB9AC\uC5D0\uC11C \uBC97\uC774 \uC790\uB124\uB97C
    \uBC00\uC5B4 \uC62C\uB9AC\uACE0 \uB5A8\uC5B4\uC84C\uB124. \uC0AC\uB78C\uB4E4\uC740
    \uADF8\uB97C \uC601\uC6C5\uC774\uB77C \uBD80\uB974\uC9C0\uB9CC, \uB9C8\uC9C0\uB9C9
    \uD45C\uC815\uC740 \uC544\uBB34\uB3C4 \uBABB \uBCF4\uC558\uC9C0. \uC790\uB124\uB294
    \uADF8\uC758 \uC8FD\uC74C\uC744 \uC5B4\uB5BB\uAC8C \uAE30\uC5B5\uD558\uACA0\uB098?"
  answers:
  - answerText: "\uB098\uB97C \uC704\uD55C \uD76C\uC0DD"
    rewardToken: {fileID: 11400000, guid: 1cc0ed3bfc5cbfe49a6c24741baaa40f, type: 2}
    npcComment: "\uC790\uB124\uB97C \uC704\uD55C \uC77C\uC774\uC5C8\uB2E4\uACE0 \uBBFF\uB294\uAD70.
      \uADF8 \uBBFF\uC74C\uC774 \uC790\uB124\uB97C \uC0B4\uAC8C \uD560 \uC218\uB3C4
      \uC788\uACA0\uC9C0."
  - answerText: "\uB3CC\uC774\uD0AC \uC218 \uC5C6\uB294 \uC0AC\uACE0"
    rewardToken: {fileID: 11400000, guid: d614d8b7c6778164fa441ea8074cc445, type: 2}
    npcComment: "\uC0AC\uACE0\uB77C \uBD80\uB974\uB294\uAD70. \uADF8 \uB9D0 \uC548\uC5D0\uB3C4
      \uC790\uB124\uB97C \uBC00\uC5B4 \uC62C\uB9B0 \uC190\uC740 \uB0A8\uC544 \uC788\uB098."
  - answerText: "\uB05D\uB0B4 \uBAA8\uB97C \uC120\uD0DD"
    rewardToken: {fileID: 11400000, guid: 6edef52451089124e83c304509192e6e, type: 2}
    npcComment: "\uBAA8\uB974\uB294 \uCC44 \uB450\uACA0\uB2E4\uB294 \uAC74\uAC00.
      \uC0AC\uB78C\uB4E4\uC740 \uBE48\uC790\uB9AC\uC5D0 \uC800\uB9C8\uB2E4 \uC774\uC57C\uAE30\uB97C
      \uCC44\uC6B8 \uD150\uB370."
