  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_01_Question
  m_EditorClassIdentifier: 
  questionText: "\uC774 \uC232\uC5D0\uC11C\uB294 \uC8FD\uC740 \uC774\uB97C \uD55C
    \uBC88 \uAE68\uC6B8 \uC218 \uC788\uB124. \uB300\uC2E0 \uC5B4\uB514\uC120\uAC00
    \uB0AF\uC120 \uC774\uC758 \uC228\uC774 \uD558\uB098 \uBA4E\uC9C0. \uAE68\uC5B4\uB09C
    \uC774\uB294 \uADF8 \uB300\uAC00\uB97C \uBAA8\uB97C \uAC78\uC138. \uC790\uB124\uB294
    \uB204\uAD6C\uC758 \uC190\uC744 \uC7A1\uACA0\uB098?"
  answers:
  - answerText: "\uADF8 \uC0AC\uB78C\uC744 \uAE68\uC6B4\uB2E4"
    rewardToken: {fileID: 11400000, guid: 028abe153687e6440b8042ed537a4843, type: 2}
    npcComment: "\uC7A1\uC740 \uC190\uC740 \uB530\uB73B\uD574\uC9C0\uACA0\uAD70.
      \uB193\uCE5C \uC190\uC758 \uC628\uB3C4\uB294 \uB05D\uB0B4 \uBAA8\uB97C \uD14C\uACE0."
  - answerText: "\uB0AF\uC120 \uC774\uB97C \uC9C0\uD0A8\uB2E4"
    rewardToken: {fileID: 11400000, guid: 1cc0ed3bfc5cbfe49a6c24741baaa40f, type: 2}
    npcComment: "\uC774\uB984\uB3C4 \uBAA8\uB974\uB294 \uC774\uB97C \uC9C0\uD0A4\uB294\uAD70.
      \uB3CC\uC544\uC624\uC9C0 \uBABB\uD55C \uC774\uB294 \uC790\uB124 \uC774\uB984\uC744
      \uC54C \uD150\uB370."
  - answerText: "\uB300\uAC00\uBD80\uD130 \uBC1D\uD78C\uB2E4"
    rewardToken: {fileID: 11400000, guid: 2491c485c9c20db4f8ad303f1776378e, type: 2}
    npcComment: "\uB300\uAC00\uB97C \uC54C\uAC8C \uB41C \uB4A4\uC5D0\uB3C4 \uAC19\uC740
      \uC190\uC744 \uC7A1\uC744 \uC218 \uC788\uACA0\uB098?"
