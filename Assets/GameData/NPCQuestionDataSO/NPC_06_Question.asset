  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_06_Question
  m_EditorClassIdentifier: 
  questionText: "\uAD76\uC8FC\uB9B0 \uC9D0\uC2B9 \uC55E\uC5D0 \uC5B4\uB9B0 \uC0AC\uC2B4\uC774
    \uC4F0\uB7EC\uC838 \uC788\uB124. \uC0AC\uC2B4\uC744 \uAD6C\uD558\uBA74 \uAD74\uC18D\uC758
    \uC0C8\uB07C\uB4E4\uC774 \uAD76\uACE0, \uC9C0\uB098\uCE58\uBA74 \uC0AC\uC2B4\uC758
    \uC228\uC774 \uBA4E\uACA0\uC9C0. \uC790\uB124 \uC190\uC740 \uC5B4\uB514\uB85C
    \uD5A5\uD558\uB098?"
  answers:
  - answerText: "\uC0AC\uC2B4\uC744 \uAD6C\uD55C\uB2E4"
    rewardToken: {fileID: 11400000, guid: 1cc0ed3bfc5cbfe49a6c24741baaa40f, type: 2}
    npcComment: "\uC624\uB298 \uC0AC\uC2B4\uC740 \uC0B4\uACA0\uAD70. \uAD74\uC18D\uC758
      \uBC30\uACE0\uD514\uC740 \uB0B4\uC77C\uB3C4 \uC790\uB124\uB97C \uAE30\uB2E4\uB9AC\uACA0\uC9C0."
  - answerText: "\uC9D0\uC2B9\uC744 \uBA39\uC778\uB2E4"
    rewardToken: {fileID: 11400000, guid: a6cf9b8c4e57b494da4215700341c5ee, type: 2}
    npcComment: "\uBA39\uC774\uB97C \uAC74\uB124\uB294 \uC190\uC774\uAD70. \uC9D0\uC2B9\uC740
      \uB2E4\uC74C\uC5D0\uB3C4 \uADF8 \uC190\uC744 \uC54C\uC544\uBCFC \uD14C\uC9C0."
  - answerText: "\uB2E4\uB978 \uBA39\uC774\uB97C \uCC3E\uB294\uB2E4"
    rewardToken: {fileID: 11400000, guid: dccb49a812de6464ba636f5b9bbd11af, type: 2}
    npcComment: "\uB2E4\uB978 \uBA39\uC774\uB77C\u2026 \uADF8 \uBA39\uC774\uC5D0\uAC8C\uB3C4
      \uC774 \uC774\uC57C\uAE30\uB294 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uC2DC\uC791\uB418\uACA0\uAD70."
