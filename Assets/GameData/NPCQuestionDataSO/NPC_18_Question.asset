  m_Script: {fileID: 11500000, guid: 1831be51dc407be40a0f310b82bad97c, type: 3}
  m_Name: NPC_18_Question
  m_EditorClassIdentifier: 
  questionText: "\uC774 \uC2EC\uC7A5\uC740 \uBA4E\uC740 \uBAB8\uC744 \uB2E4\uC2DC
    \uC6C0\uC9C1\uC774\uAC8C \uD558\uC9C0. \uB2E4\uB9CC \uC608\uC804 \uC8FC\uC778\uC774
    \uC0AC\uB791\uD588\uB358 \uAC83\uC744 \uD568\uAED8 \uC0AC\uB791\uD558\uAC8C \uB41C\uB2E4\uB124.
    \uB418\uC0B4\uC544\uB09C \uC790\uC758 \uB9C8\uC74C\uC740 \uB204\uAD6C\uC758 \uAC83\uC774\uB77C
    \uC0DD\uAC01\uD558\uB098?"
  answers:
  - answerText: "\uB2E4\uC2DC \uC0B0 \uC790\uC758 \uAC83"
    rewardToken: {fileID: 11400000, guid: 022bc19273559ef48aa607846ed166e1, type: 2}
    npcComment: "\uC9C0\uAE08 \uB6F0\uB294 \uAC00\uC2B4\uC758 \uAC83\uC774\uB77C\u2026
      \uADF8 \uC548\uC5D0\uC11C \uB0AF\uC120 \uADF8\uB9AC\uC6C0\uC774 \uC790\uB77C\uB3C4
      \uB9D0\uC778\uAC00."
  - answerText: "\uC61B \uC8FC\uC778\uC758 \uAC83"
    rewardToken: {fileID: 11400000, guid: 028abe153687e6440b8042ed537a4843, type: 2}
    npcComment: "\uB5A0\uB09C \uC8FC\uC778\uC758 \uAC83\uC774\uB77C \uBD80\uB974\uB294\uAD70.
      \uB0A8\uC740 \uBAB8\uC740 \uADF8\uC800 \uC624\uB798 \uBE4C\uB9B0 \uBC29\uC778\uAC00."
  - answerText: "\uB458\uC774 \uB098\uB204\uB294 \uAC83"
    rewardToken: {fileID: 11400000, guid: a767aeb2b20e5564180b844f53e601d8, type: 2}
    npcComment: "\uD568\uAED8 \uB098\uB204\uACA0\uB2E4\uB294\uAD70. \uAC19\uC740
      \uC774\uB97C \uC0AC\uB791\uD560 \uB54C\uB294 \uC26C\uC6B4 \uB2F5\uC77C \uC218\uB3C4
      \uC788\uB124."
